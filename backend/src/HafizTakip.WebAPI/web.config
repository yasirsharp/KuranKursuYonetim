<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS ayarı (yayında dotnet publish aspNetCore satırını kendisi tamamlar).
  - WebDAV kapatılır: açıkken IIS PUT/DELETE isteklerini uygulamaya iletmeden 405 döndürür.
  - Güvenlik başlıkları eklenir, sunucu/teknoloji bilgisi gizlenir.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\HafizTakip.WebAPI.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="outofprocess" />
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="Strict-Transport-Security" value="max-age=31536000" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
