{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSqlConnection": ""
  },
  "TokenOptions": {
    "Audience": "hafiz-takip-clients",
    "Issuer": "hafiz-takip-api",
    "AccessTokenExpiration": 60,
    "RefreshTokenExpirationDays": 30,
    "SecurityKey": ""
  },
  "Otp": {
    "CodeLength": 6,
    "ExpiryMinutes": 3,
    "MaxVerifyAttempts": 5,
    "ResendCooldownSeconds": 60,
    "MaxSendsPerHour": 5
  },
  "Sms": {
    "Provider": "netgsm",
    "NetGsm": {
      "UserCode": "",
      "Password": "",
      "Header": ""
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Dev": {
    "EnableSeed": false
  }
}
